{
  "name": "threadspan",
  "version": "0.6.0",
  "description": "One task across OpenAI Codex, Cursor, Grok Build, Nous Portal, OpenRouter, and compatible providers.",
  "type": "module",
  "bin": {
    "threadspan": "./src/cli.mjs",
    "cursor-bridge": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "skills",
    "prompts",
    "config",
    "docs",
    "examples",
    "scripts/check.mjs",
    "scripts/release-bundle.mjs",
    "test",
    "ui",
    "integrations",
    "!**/.working*",
    "README.md",
    "DELIVERY.md",
    "LICENSE",
    "NOTICE.md",
    "AGENTS.md",
    "STATUS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "node ./scripts/check.mjs",
    "test": "node --test --test-reporter=spec test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "test:release-bundle": "node --test --test-reporter=spec test/release-bundle.test.mjs",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run",
    "release:bundle": "node ./scripts/release-bundle.mjs"
  },
  "optionalDependencies": {
    "@cursor/sdk": "1.0.23"
  },
  "keywords": [
    "cursor",
    "codex",
    "mcp",
    "responses-api",
    "deepseek",
    "nous-portal",
    "agent-bridge",
    "grok-build",
    "xai",
    "managed-worker",
    "worktree",
    "grok",
    "openrouter",
    "model-router",
    "continuity",
    "model-picker"
  ],
  "license": "MIT"
}
